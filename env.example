# Скопируй этот файл в .env и заполни своими значениями
# .env НЕ должен попадать в git / никуда не публиковаться

# Токен бота, который выдаёт @BotFather в Telegram
TELEGRAM_BOT_TOKEN=

# Ключ YouTube Data API v3 из Google Cloud Console
YOUTUBE_API_KEY=

# Необязательно: ключ Anthropic (console.anthropic.com) — включает живой ИИ-анализ
# трендов вместо шаблонного. Без него бот тоже работает, просто анализ попроще.
ANTHROPIC_API_KEY=
# Модель для анализа (по умолчанию — быстрая и дешёвая, этого достаточно)
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Необязательно: chat_id для старой ежедневной рассылки в 10:00 (полная таблица).
# Обычные регулярные уведомления теперь включаются прямо в боте командой /notify —
# это поле НЕ обязательно заполнять для них.
# Узнать свой chat_id: напиши боту @userinfobot
DIGEST_CHAT_ID=
