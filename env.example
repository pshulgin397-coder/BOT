# Скопируй этот файл в .env и заполни своими значениями
# .env НЕ должен попадать в git / никуда не публикуйся

# Токен бота, который выдаёт @BotFather в Telegram
TELEGRAM_BOT_TOKEN=

# Ключ YouTube Data API v3 из Google Cloud Console
YOUTUBE_API_KEY=

# Твой chat_id в Telegram — нужен только для автоматической ежедневной рассылки.
# Если не заполнишь, бот всё равно будет работать по команде /trends вручную.
# Узнать свой chat_id: напиши боту @userinfobot, он пришлёт число.
DIGEST_CHAT_ID=

# Время ежедневной рассылки по МСК, формат ЧЧ:ММ (только если DIGEST_CHAT_ID задан)
DIGEST_TIME=10:00
